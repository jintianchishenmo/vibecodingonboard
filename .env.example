# Local development defaults. Copy to .env and change for production.

# Port the platform API listens on
LZ_API_PORT=8787

# Where the database, uploads and build logs live
LZ_DATA_DIR=data

# User apps are served at <app>.<LZ_APPS_DOMAIN>
# Local: localhost (browsers resolve *.localhost to 127.0.0.1 automatically)
# Production: e.g. yourbrand-apps.app
LZ_APPS_DOMAIN=localhost
LZ_PUBLIC_SCHEME=http
LZ_PUBLIC_PORT=80

# Shown to users when they run out of quota
LZ_UPGRADE_URL=http://localhost:8787/pricing

# Per-app resource limits (the base plan from the pricing design)
LZ_APP_MEMORY=512m
LZ_APP_CPUS=0.25

# Max upload size for one deployment
LZ_MAX_UPLOAD_MB=50
